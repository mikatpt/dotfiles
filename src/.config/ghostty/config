# Scrollback (~10k lines in bytes)
scrollback-limit = 10000000

# Bell
bell-features = no-audio

# Display
link-url = true
window-padding-y = 10
window-padding-x = 10,0

# Font
font-family = SauceCodePro Nerd Font Mono
font-style = Medium
font-family = Fira Code
font-family = Cascadia Code
font-size = 19
adjust-cell-width = -10%
alpha-blending = linear-corrected
window-colorspace = display-p3

# Colors
background = #000A14
foreground = #CCCCCC
cursor-color = #C1CBF5
cursor-text = #000000
selection-background = #CFFFC2
selection-foreground = #000000

shell-integration-features = no-cursor

# Pane separators, matching the tmux violet border color.
split-divider-color = #a9a1e1

# No dimming of unfocused splits (Ghostty defaults to 0.7 opacity).
unfocused-split-opacity = 1

# ANSI palette — mirrors wezterm ansi (0-7) + brights (8-15)
# macOS variant: red=hl.red (#F50000), green=hl.green (#07C057)
palette = 0=#0C0033
palette = 1=#F50000
palette = 2=#07C057
palette = 3=#FDE9A0
palette = 4=#055BBD
palette = 5=#881797
palette = 6=#2FFCF6
palette = 7=#CCCCCC
palette = 8=#7A7A7A
palette = 9=#F50000
palette = 10=#00F500
palette = 11=#FDE9A0
palette = 12=#2E7CD6
palette = 13=#B347FF
palette = 14=#00F5F5
palette = 15=#F2F2F2

clipboard-trim-trailing-spaces = true

#################################
###   tmux-style keybindings  ###
#################################

keybind = ctrl+,=activate_key_table_once:tmux
keybind = tmux/

# Splits
keybind = tmux/ctrl+[=new_split:right
keybind = tmux/ctrl+]=new_split:down

# Pane navigation
keybind = tmux/ctrl+h=goto_split:left
keybind = tmux/ctrl+l=goto_split:right
keybind = tmux/ctrl+k=goto_split:previous
keybind = tmux/ctrl+j=goto_split:next
keybind = tmux/j=goto_split:down
keybind = tmux/k=goto_split:up

# Pane resizing
keybind = tmux/arrow_up=resize_split:up,2
keybind = tmux/arrow_down=resize_split:down,2
keybind = tmux/arrow_left=resize_split:left,2
keybind = tmux/arrow_right=resize_split:right,2
keybind = tmux/ctrl+arrow_up=resize_split:up,2
keybind = tmux/ctrl+arrow_down=resize_split:down,2
keybind = tmux/ctrl+arrow_left=resize_split:left,2
keybind = tmux/ctrl+arrow_right=resize_split:right,2

# Windows -> tabs
keybind = tmux/t=new_tab
keybind = tmux/ctrl+t=new_tab
keybind = tmux/ctrl+p=previous_tab
keybind = tmux/ctrl+n=next_tab
keybind = tmux/ctrl+1=goto_tab:1
keybind = tmux/ctrl+2=goto_tab:2
keybind = tmux/ctrl+3=goto_tab:3
keybind = tmux/ctrl+4=goto_tab:4
keybind = tmux/ctrl+5=goto_tab:5
keybind = tmux/ctrl+6=goto_tab:6
keybind = tmux/ctrl+7=goto_tab:7
keybind = tmux/ctrl+8=goto_tab:8
keybind = tmux/ctrl+9=goto_tab:9

# Sessions -> OS windows
keybind = tmux/a=new_window
keybind = tmux/ctrl+a=new_window

# Rename tab (tmux: , / C-, rename-window)
keybind = tmux/,=prompt_tab_title
keybind = tmux/ctrl+,=prompt_tab_title

# Kill pane / reload config (tmux: C-w confirm-kill-pane, C-r/r reload)
keybind = tmux/ctrl+w=close_surface
keybind = tmux/ctrl+r=reload_config
keybind = tmux/r=reload_config

# Move tabs without the prefix (tmux: bind -n C-S-Left/Right swap-window)
keybind = ctrl+shift+left=move_tab:-1
keybind = ctrl+shift+right=move_tab:1

# Vim mode
keybind = tmux/ctrl+s=activate_key_table:vim
keybind = vim/

# Line movement
keybind = vim/j=scroll_page_lines:1
keybind = vim/k=scroll_page_lines:-1

# Page movement
keybind = vim/ctrl+d=scroll_page_down
keybind = vim/ctrl+u=scroll_page_up
keybind = vim/ctrl+f=scroll_page_down
keybind = vim/ctrl+b=scroll_page_up
keybind = vim/shift+j=scroll_page_down
keybind = vim/shift+k=scroll_page_up

# Jump to top/bottom
keybind = vim/g>g=scroll_to_top
keybind = vim/shift+g=scroll_to_bottom

# Search (if you want vim-style search entry)
keybind = vim/slash=start_search
keybind = vim/n=navigate_search:next

# Copy mode / selection
# Note we're missing a lot of actions here to make this more full featured.
keybind = vim/v=copy_to_clipboard
keybind = vim/y=copy_to_clipboard

# Command Palette
keybind = vim/shift+semicolon=toggle_command_palette

# Exit
keybind = vim/escape=deactivate_key_table
keybind = vim/q=deactivate_key_table
keybind = vim/i=deactivate_key_table

# Catch unbound keys
keybind = vim/catch_all=ignore

# Catch unbound keys so the prefix doesn't leak stray input
keybind = tmux/catch_all=ignore
